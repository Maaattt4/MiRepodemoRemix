<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="@color/aero_green"
                android:endColor="@color/aero_green_dark"
                android:startColor="@color/aero_green_light" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:right="8dp"
        android:top="2dp"
        android:height="22dp"
        android:gravity="top">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#14FFFFFF"
                android:startColor="#99FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
