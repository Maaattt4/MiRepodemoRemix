<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CloneWhatsApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/aero_cyan</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/aero_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@drawable/bg_aero_fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="Theme.CloneWhatsApp" parent="Base.Theme.CloneWhatsApp" />

    <style name="Widget.Aero.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_glossy</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Aero.Button.Verde" parent="Widget.Aero.Button">
        <item name="android:background">@drawable/bg_btn_glossy_verde</item>
    </style>

    <style name="Widget.Aero.Button.Glass" parent="Widget.Aero.Button">
        <item name="android:background">@drawable/bg_btn_glass</item>
        <item name="android:textColor">@color/aero_navy</item>
    </style>

    <style name="Aero.Input" parent="">
        <item name="android:background">@drawable/bg_glass_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/aero_navy</item>
        <item name="android:textColorHint">@color/aero_navy_soft</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Aero.Titulo" parent="">
        <item name="android:textColor">@color/aero_navy</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#99FFFFFF</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
    </style>
</resources>
